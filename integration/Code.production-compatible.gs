" value=\"Validação fictícia do piloto privado\"></label><button id=\"advance\">Atualizar etapa</button><button id=\"reopen\">Reabrir OS concluída</button>\r\n<button id=\"retry\" hidden>Repetir mesmo comando pendente</button></section></div></section>\r\n<p id=\"status\" class=\"pilot-status\" role=\"status\">Entre com a credencial existente. Não envie a senha pelo chat.</p><section class=\"panel pilot-history\"><h2>Histórico da ordem</h2><p class=\"muted\">Selecione uma OS salva para consultar os eventos confirmados.</p><pre id=\"output\"></pre></section><footer>© 2026 RSF Clean Services LLC · Portal operacional · teste privado</footer></main></div>\r\n<script>\r\n(()=>{'use strict';let session=null,current=null,pending=null,busy=false;const project='PILOTO_FICTICIO_RSF_20261021';const el=id=>document.getElementById(id);\r\nfunction lock(v){busy=v;document.querySelectorAll('main button,main input,main textarea,main select').forEach(x=>x.disabled=v||!!pending);el('retry').disabled=v;el('retry').hidden=!pending;}\r\nfunction rpc(p){return new Promise((resolve,reject)=>google.script.run.withSuccessHandler(resolve).withFailureHandler(()=>reject(new Error('TRANSPORT'))).privatePilotRequest(p));}\r\nfunction show(w){current=w;el('output').textContent=JSON.stringify(w,null,2);el('output').hidden=true;let view=el('order-view');if(!view){view=document.createElement('div');view.id='order-view';el('output').before(view);}view.replaceChildren();const add=(tag,text,parent=view)=>{const n=document.createElement(tag);n.textContent=text;parent.append(n);return n;};add('h3',w.status);add('p',w.escopo);add('p','Responsável: '+(w.responsavel||'A definir')+' · Revisão '+w.revisao);add('small','OS '+w.osId);const timeline=add('ol','');timeline.className='pilot-timeline';(w.historico||[]).forEach(e=>{const item=add('li','',timeline);add('strong',e.StatusNovo+' · '+e.TipoEvento,item);const dt=new Date(e.CriadoEm);add('p',(Number.isFinite(dt.getTime())?dt.toLocaleString('pt-BR'):'Data indisponível')+' · '+e.UsuarioId,item);if(e.Motivo)add('p',e.Motivo,item);});}\r\nasync function call(p,mutation=false){if(busy)return; if(mutation)pending=Object.freeze({...p});lock(true);try{const r=await rpc(p);if(!r||typeof r.ok!=='boolean')throw Error('TRANSPORT');if(!r.ok){if(r.code!=='WRITE_UNCONFIRMED')pending=null;el('status').textContent=r.erro||'Pedido não confirmado.';return;}pending=null;el('status').textContent='Resposta confirmada pelo backend privado.';if(r.workOrder)show(r.workOrder);return r;}catch(e){el('status').textContent=pending?'Resposta incerta. Repita o mesmo comando; não crie outra OS.':'Falha de transporte. Tente a leitura novamente.';}finally{lock(false);}}\r\nfunction base(action){return {action,token:session.token,projetoId:project};}\r\nfunction change(action,extra){if(!current){el('status').textContent='Abra uma OS primeiro.';return;}return call({...base(action),osId:current.osId,expectedRevision:current.revisao,requestId:crypto.randomUUID(),...extra},true);}\r\nel('login').onsubmit=async e=>{e.preventDefault();const password=el('password').value;el('password').value='';const r=await call({action:'login',username:'boss',password});if(r&&r.session){session=r.session;el('login').hidden=true;el('work').hidden=false;}};\r\nel('create').onclick=()=>call({...base('createOsOperacional'),requestId:crypto.randomUUID(),escopo:el('scope').value},true);\r\nel('list').onclick=async()=>{const r=await call(base('listOsOperacional'));if(r){el('orders').replaceChildren();r.workOrders.forEach(w=>{const o=document.createElement('option');o.value=w.osId;o.textContent=w.osId+' — '+w.status;el('orders').append(o);});el('status').textContent=r.workOrders.length+' OS salvas no projeto fictício.';}};\r\nel('detail').onclick=()=>call({...base('detailOsOperacional'),osId:el('orders').value});\r\nel('assign').onclick=()=>change('assignOsOperacional',{responsavel:'boss'});\r\nel('advance').onclick=()=>change('advanceOsOperacional',{statusNovo:el('stage').value,motivo:el('reason').value});\r\nel('reopen').onclick=()=>change('reopenOsOperacional',{statusNovo:'Em execução',motivo:el('reason').value});\r\nel('retry').onclick=()=>pending&&call(pending,true);\r\nel('logout').onclick=async()=>{const r=await call(base('logout'));if(r){session=null;current=null;el('output').textContent='';if(el('order-view'))el('order-view').replaceChildren();el('work').hidden=true;el('login').hidden=false;}};\r\nwindow.addEventListener('beforeunload',e=>{if(pending){e.preventDefault();e.returnValue='';}});\r\n})();\r\n</script></html>\r\n";}
